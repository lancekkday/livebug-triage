<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sequence — TICKET_ID_PLACEHOLDER</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0f1117;
      color: #e2e8f0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header {
      background: #1a1d27;
      border-bottom: 1px solid #2d3748;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      z-index: 10;
    }
    header h1 { font-size: 14px; font-weight: 600; color: #f7fafc; }

    .ticket-badge {
      background: #2b6cb0; color: #bee3f8;
      padding: 3px 10px; border-radius: 12px;
      font-size: 12px; font-weight: 600;
    }
    .env-badge { padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .env-badge.prod  { background: #742a2a; color: #fed7d7; }
    .env-badge.stage { background: #744210; color: #fefcbf; }
    .env-badge.sit   { background: #1a365d; color: #bee3f8; }

    .main {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    .diagram-wrapper {
      flex: 1;
      overflow: auto;
      position: relative;
    }

    #seq-svg {
      display: block;
      min-width: 100%;
    }

    /* ── Sidebar ── */
    #sidebar {
      width: 300px;
      background: #1a1d27;
      border-left: 1px solid #2d3748;
      overflow-y: auto;
      flex-shrink: 0;
    }
    #sidebar.empty {
      display: flex; align-items: center; justify-content: center;
    }
    .sidebar-hint { color: #4a5568; font-size: 13px; text-align: center; padding: 20px; }

    .detail-section { padding: 16px; }
    .detail-title {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em;
      color: #718096; margin-bottom: 10px;
    }
    .detail-row { display: flex; gap: 8px; margin-bottom: 8px; font-size: 12px; }
    .detail-key { color: #718096; min-width: 80px; flex-shrink: 0; }
    .detail-val { color: #e2e8f0; word-break: break-all; }
    .detail-val.ok   { color: #68d391; }
    .detail-val.warn { color: #f6ad55; }
    .detail-val.error { color: #fc8181; }

    .error-box {
      background: #2d1515; border: 1px solid #742a2a;
      border-radius: 6px; padding: 10px; margin-top: 8px;
    }
    .error-box .code { font-family: monospace; font-size: 12px; color: #fc8181; margin-bottom: 4px; }
    .error-box .desc { font-size: 12px; color: #feb2b2; line-height: 1.5; }

    .uuid-box {
      font-family: monospace; font-size: 10px; color: #90cdf4;
      background: #1a2744; border-radius: 4px;
      padding: 4px 8px; word-break: break-all; margin-top: 4px;
    }
    .trace-links { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .trace-link {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 10px; padding: 3px 8px; border-radius: 4px;
      text-decoration: none; font-weight: 500;
    }
    .trace-link.kibana { background: #1a2744; color: #90cdf4; border: 1px solid #2b4a7a; }
    .trace-link.jaeger { background: #1a2a1a; color: #68d391; border: 1px solid #276749; }
    .trace-link:hover { opacity: 0.8; }
    .divider { border: none; border-top: 1px solid #2d3748; margin: 10px 0; }

    /* ── Footer legend ── */
    .legend {
      display: flex; gap: 16px; padding: 7px 20px;
      background: #1a1d27; border-top: 1px solid #2d3748;
      font-size: 11px; flex-shrink: 0; align-items: center;
    }
    .legend-item { display: flex; align-items: center; gap: 5px; color: #718096; }
    .legend-line { width: 22px; height: 2px; }
    .legend-line.ok    { background: #68d391; }
    .legend-line.warn  { background: #f6ad55; }
    .legend-line.error { background: #fc8181; }
    .legend-line.resp  { background: #718096;
      background-image: repeating-linear-gradient(90deg,#718096 0,#718096 5px,transparent 5px,transparent 9px); }
  </style>
</head>
<body>

<header>
  <span class="ticket-badge">TICKET_ID_PLACEHOLDER</span>
  <h1>Call Chain · Sequence Diagram</h1>
  <span class="env-badge ENV_CLASS_PLACEHOLDER">ENV_PLACEHOLDER</span>
</header>

<div class="main">
  <div class="diagram-wrapper">
    <svg id="seq-svg"></svg>
  </div>
  <div id="sidebar" class="empty">
    <p class="sidebar-hint">點擊箭頭查看詳情</p>
  </div>
</div>

<div class="legend">
  <div class="legend-item"><div class="legend-line ok"></div>2xx 成功</div>
  <div class="legend-item"><div class="legend-line warn"></div>4xx 用戶端錯誤</div>
  <div class="legend-item"><div class="legend-line error"></div>5xx / Exception</div>
  <div class="legend-item"><div class="legend-line resp"></div>Response（虛線）</div>
  <span style="margin-left:auto;color:#4a5568;font-size:11px">點擊箭頭查看詳情 · 橫向捲動可看完整路徑</span>
</div>

<script>
const graphData = GRAPH_DATA_PLACEHOLDER;

/* ── Layout constants ── */
const PAD_LEFT    = 68;   // space for timestamp
const PAD_TOP     = 0;
const PAD_BOT     = 40;
const HDR_H       = 82;   // service box area height
const ROW_H       = 60;   // height per message row
const SVC_BOX_W   = 148;
const SVC_BOX_H   = 46;
const SVC_BOX_R   = 6;
const ARROW_HEAD  = 9;    // arrowhead length

const COLOR = { ok: '#68d391', warn: '#f6ad55', error: '#fc8181', neutral: '#718096' };

/* ── Env-based URLs for trace links ── */
const ENV = 'ENV_PLACEHOLDER';
const KIBANA_BASE = ENV === 'stage' ? 'https://kibana.stage.kkday.com'
                  : ENV === 'sit'   ? 'https://kibana.sit.kkday.com'
                  :                   'https://kibana.kkday.com';
const JAEGER_BASE = ENV === 'stage' ? 'https://jaeger-query.stage.kkday.com'
                  : ENV === 'sit'   ? 'https://jaeger-query.sit.kkday.com'
                  :                   'https://jaeger-query.kkday.com';

function statusColor(sc) { return COLOR[sc] || COLOR.neutral; }

function svgEl(tag, attrs = {}) {
  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
  return el;
}

function svgText(content, attrs = {}) {
  const el = svgEl('text', attrs);
  el.textContent = content;
  return el;
}

/* ── Build arrowhead markers ── */
function buildDefs(svg) {
  const defs = svgEl('defs');
  for (const [name, color] of Object.entries(COLOR)) {
    for (const type of ['solid', 'dashed']) {
      const id = `ah-${name}-${type}`;
      const marker = svgEl('marker', {
        id, markerWidth: '10', markerHeight: '7',
        refX: '9', refY: '3.5', orient: 'auto'
      });
      const poly = svgEl('polygon', {
        points: '0 0, 10 3.5, 0 7',
        fill: type === 'dashed' ? 'none' : color,
        stroke: color, 'stroke-width': '1'
      });
      marker.appendChild(poly);
      defs.appendChild(marker);
    }
  }
  svg.appendChild(defs);
}

/* ── Render ── */
function render() {
  const svg = document.getElementById('seq-svg');
  svg.innerHTML = '';

  const services  = graphData.services  || [];
  const messages  = graphData.messages  || [];
  if (!services.length) return;

  const wrapperW = svg.parentElement.clientWidth;
  const minColW  = SVC_BOX_W + 24;
  const colW     = Math.max(minColW, (wrapperW - PAD_LEFT) / services.length);
  const totalW   = Math.max(wrapperW, PAD_LEFT + colW * services.length + 20);
  const totalH   = HDR_H + messages.length * ROW_H + PAD_BOT;

  svg.setAttribute('width',   totalW);
  svg.setAttribute('height',  totalH);
  svg.setAttribute('viewBox', `0 0 ${totalW} ${totalH}`);

  buildDefs(svg);

  /* col centre x for each service */
  const cx = (i) => PAD_LEFT + colW * i + colW / 2;
  const svcIdx = {};
  services.forEach((s, i) => { svcIdx[s.id] = i; });

  /* ── Lifelines ── */
  services.forEach((svc, i) => {
    const x = cx(i);
    const line = svgEl('line', {
      x1: x, y1: HDR_H, x2: x, y2: totalH - PAD_BOT,
      stroke: '#2d3748', 'stroke-width': '1.5', 'stroke-dasharray': '6,4'
    });
    svg.appendChild(line);
  });

  /* ── Service boxes ── */
  services.forEach((svc, i) => {
    const x = cx(i);
    const boxX = x - SVC_BOX_W / 2;
    const boxY = 14;

    // icon background circle
    const iconTypes = { client: '#1a365d', service: '#1a2744', db: '#1a2a1a' };
    const iconIcons  = { client: '👤', service: '⚙', db: '🗄' };
    const bgColor = iconTypes[svc.type] || iconTypes.service;

    const rect = svgEl('rect', {
      x: boxX, y: boxY, width: SVC_BOX_W, height: SVC_BOX_H,
      rx: SVC_BOX_R, fill: bgColor,
      stroke: svc.type === 'client' ? '#2b6cb0' : '#4a5568',
      'stroke-width': '1.5'
    });
    svg.appendChild(rect);

    const icon = svgText(iconIcons[svc.type] || '⚙', {
      x: boxX + 18, y: boxY + 16, 'font-size': '13', 'text-anchor': 'middle',
      'dominant-baseline': 'middle'
    });
    svg.appendChild(icon);

    const label = svgText(svc.label, {
      x: x + 6, y: boxY + 15,
      fill: svc.type === 'client' ? '#90cdf4' : '#e2e8f0',
      'font-size': '12', 'font-weight': '600', 'text-anchor': 'middle',
      'dominant-baseline': 'middle'
    });
    svg.appendChild(label);

    if (svc.type) {
      const sub = svgText(`«${svc.type}»`, {
        x: x + 6, y: boxY + 31,
        fill: '#718096', 'font-size': '9.5', 'text-anchor': 'middle'
      });
      svg.appendChild(sub);
    }
  });

  /* ── Messages ── */
  let selectedRow = null;

  messages.forEach((msg, j) => {
    const y    = HDR_H + j * ROW_H + ROW_H / 2;
    const fi   = svcIdx[msg.from] ?? 0;
    const ti   = svcIdx[msg.to]   ?? 0;
    const x1   = cx(fi);
    const x2   = cx(ti);
    const isResp = msg.type === 'response';
    const color  = statusColor(msg.statusClass);
    const markId = `ah-${msg.statusClass || 'neutral'}-${isResp ? 'dashed' : 'solid'}`;
    const isSelf = fi === ti;

    /* hover/select bg */
    const rowBg = svgEl('rect', {
      x: 0, y: y - ROW_H / 2 + 2, width: totalW, height: ROW_H - 4,
      fill: 'transparent', rx: 3, style: 'cursor:pointer'
    });
    rowBg.dataset.msgId = msg.id;

    rowBg.addEventListener('mouseenter', () => {
      if (rowBg !== selectedRow) rowBg.setAttribute('fill', 'rgba(255,255,255,0.03)');
    });
    rowBg.addEventListener('mouseleave', () => {
      if (rowBg !== selectedRow) rowBg.setAttribute('fill', 'transparent');
    });
    rowBg.addEventListener('click', () => {
      if (selectedRow) selectedRow.setAttribute('fill', 'transparent');
      selectedRow = rowBg;
      rowBg.setAttribute('fill', 'rgba(99,179,237,0.09)');
      showDetail(msg);
    });
    svg.appendChild(rowBg);

    /* timestamp */
    if (msg.timestamp) {
      const ts = svgText(msg.timestamp, {
        x: PAD_LEFT - 6, y: y + 1,
        fill: '#4a5568', 'font-size': '10',
        'text-anchor': 'end', 'dominant-baseline': 'middle'
      });
      svg.appendChild(ts);
    }

    /* self-loop */
    if (isSelf) {
      const loopW = 40, loopH = 28;
      const path = svgEl('path', {
        d: `M ${x1} ${y - loopH/2} C ${x1 + loopW} ${y - loopH/2}, ${x1 + loopW} ${y + loopH/2}, ${x1} ${y + loopH/2}`,
        fill: 'none', stroke: color, 'stroke-width': '2',
        'stroke-dasharray': isResp ? '6,3' : 'none',
        'marker-end': `url(#${markId})`
      });
      svg.appendChild(path);

      const lbl = svgText(truncate(msg.label, 24), {
        x: x1 + loopW + 4, y: y,
        fill: color, 'font-size': '10.5',
        'text-anchor': 'start', 'dominant-baseline': 'middle'
      });
      svg.appendChild(lbl);
      return;
    }

    /* arrow direction */
    const dir  = x2 > x1 ? 1 : -1;
    const ax1  = x1 + dir * 6;
    const ax2  = x2 - dir * (ARROW_HEAD + 2);

    const line = svgEl('line', {
      x1: ax1, y1: y, x2: ax2, y2: y,
      stroke: color, 'stroke-width': msg.retryCount > 1 ? '2.5' : '2',
      'stroke-dasharray': isResp ? '7,4' : 'none',
      'marker-end': `url(#${markId})`
    });
    svg.appendChild(line);

    /* label (centred on arrow, above line) */
    const midX = (ax1 + ax2) / 2;
    const labelStr = truncate(msg.label, 30);
    const lbl = svgEl('text', {
      x: midX, y: y - 9,
      fill: color, 'font-size': '10.5',
      'text-anchor': 'middle', 'dominant-baseline': 'auto'
    });
    lbl.textContent = labelStr;
    svg.appendChild(lbl);

    /* retry badge */
    if (msg.retryCount > 1) {
      const badgeX = midX + (labelStr.length * 3.2);
      const badge = svgEl('rect', {
        x: badgeX, y: y - 20, width: 30, height: 14,
        rx: 7, fill: '#744210'
      });
      const badgeTxt = svgText(`×${msg.retryCount}`, {
        x: badgeX + 15, y: y - 12,
        fill: '#f6ad55', 'font-size': '9', 'font-weight': '700',
        'text-anchor': 'middle', 'dominant-baseline': 'middle'
      });
      svg.appendChild(badge);
      svg.appendChild(badgeTxt);
    }

    /* error icon */
    if (msg.statusClass === 'error' && !isResp) {
      const ex = x2 - dir * 18;
      const ic = svgText('✕', {
        x: ex, y: y,
        fill: '#fc8181', 'font-size': '11', 'font-weight': '700',
        'text-anchor': 'middle', 'dominant-baseline': 'middle'
      });
      svg.appendChild(ic);
    }

    /* status code on response arrows */
    if (isResp && msg.status) {
      const sc = svgText(String(msg.status), {
        x: midX, y: y + 14,
        fill: color, 'font-size': '10', 'text-anchor': 'middle'
      });
      svg.appendChild(sc);
    }

    /* duration badge (from Jaeger) — only on request arrows */
    if (!isResp && msg.durationMs != null) {
      const durationColor = msg.durationMs > 3000 ? '#fc8181'
                          : msg.durationMs > 1000 ? '#f6ad55'
                          : msg.durationMs > 100  ? '#a0aec0'
                          : '#4a5568';
      const dLabel = msg.durationMs >= 1000
        ? `${(msg.durationMs / 1000).toFixed(1)}s`
        : `${msg.durationMs}ms`;
      const dur = svgText(dLabel, {
        x: midX, y: y + 13,
        fill: durationColor, 'font-size': '9.5',
        'text-anchor': 'middle', 'dominant-baseline': 'auto'
      });
      svg.appendChild(dur);
    }
  });
}

/* ── Truncate helper ── */
function truncate(str, n) {
  return str && str.length > n ? str.slice(0, n) + '…' : str;
}

/* ── HTML escape (prevent XSS from log data) ── */
function esc(str) {
  if (str == null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/* ── Sidebar detail ── */
function showDetail(msg) {
  const sidebar = document.getElementById('sidebar');
  sidebar.classList.remove('empty');

  const isResp = msg.type === 'response';
  const color  = { ok: 'ok', warn: 'warn', error: 'error' }[msg.statusClass] || '';

  const retryRow = msg.retryCount > 1
    ? `<div class="detail-row"><span class="detail-key">Retry 次數</span><span class="detail-val warn">${esc(msg.retryCount)} 次</span></div>` : '';

  const errorBlock = (msg.errorCode || msg.errorDesc)
    ? `<hr class="divider"><div class="detail-title">錯誤詳情</div>
       <div class="error-box">
         ${msg.errorCode ? `<div class="code">status=${esc(msg.errorCode)}</div>` : ''}
         ${msg.errorDesc ? `<div class="desc">${esc(msg.errorDesc)}</div>` : ''}
       </div>` : '';

  const uuidBlock = (msg.requestUuid || msg.traceId) ? (() => {
    const kibanaUrl = msg.requestUuid
      ? `${KIBANA_BASE}/app/discover#/?_a=(query:(language:kuery,query:'request.uuid:"${msg.requestUuid}"'))`
      : null;
    const jaegerUrl = msg.traceId
      ? `${JAEGER_BASE}/trace/${msg.traceId}`
      : null;
    return `<hr class="divider"><div class="detail-title">追蹤 ID</div>
      ${msg.requestUuid ? `<div class="detail-key" style="font-size:10px;margin-top:4px">request.uuid</div><div class="uuid-box">${esc(msg.requestUuid)}</div>` : ''}
      ${msg.traceId     ? `<div class="detail-key" style="font-size:10px;margin-top:6px">Jaeger trace</div><div class="uuid-box">${esc(msg.traceId)}</div>` : ''}
      <div class="trace-links">
        ${kibanaUrl ? `<a class="trace-link kibana" href="${kibanaUrl}" target="_blank">📋 Kibana</a>` : ''}
        ${jaegerUrl ? `<a class="trace-link jaeger" href="${jaegerUrl}" target="_blank">🔍 Jaeger</a>` : ''}
      </div>`;
  })() : '';

  sidebar.innerHTML = `
    <div class="detail-section">
      <div class="detail-title">${isResp ? 'Response' : 'Request'}</div>
      <div class="detail-row"><span class="detail-key">方向</span>
        <span class="detail-val">${esc(labelOf(msg.from))} → ${esc(labelOf(msg.to))}</span></div>
      ${msg.method ? `<div class="detail-row"><span class="detail-key">Method</span><span class="detail-val">${esc(msg.method)}</span></div>` : ''}
      ${msg.path   ? `<div class="detail-row"><span class="detail-key">Path</span><span class="detail-val" style="font-family:monospace;font-size:11px">${esc(msg.path)}</span></div>` : ''}
      <div class="detail-row"><span class="detail-key">HTTP Status</span>
        <span class="detail-val ${color}">${esc(msg.status) || '—'}</span></div>
      ${retryRow}
      ${msg.durationMs != null ? `<div class="detail-row"><span class="detail-key">Duration</span><span class="detail-val ${msg.durationMs > 3000 ? 'error' : msg.durationMs > 1000 ? 'warn' : ''}">${msg.durationMs >= 1000 ? (msg.durationMs/1000).toFixed(1)+'s' : msg.durationMs+'ms'}</span></div>` : ''}
      ${msg.timestamp ? `<div class="detail-row"><span class="detail-key">時間</span><span class="detail-val">${esc(msg.timestamp)}</span></div>` : ''}
      ${errorBlock}
      ${uuidBlock}
    </div>`;
}

function labelOf(id) {
  const s = (graphData.services || []).find(s => s.id === id);
  return s?.label ?? id;
}

/* ── Init ── */
render();
window.addEventListener('resize', render);
</script>
</body>
</html>
